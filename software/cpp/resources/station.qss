QMainWindow, QWidget#centralWidget { background: #0b1017; color: #f2f7fc; }
QWidget { font-size: 10pt; }
QFrame#headerFrame { background: #111a25; border-bottom: 1px solid #263649; }
QLabel#eyebrowLabel { color: #55e2d2; font-size: 9pt; font-weight: 700; letter-spacing: 1px; }
QLabel#titleLabel { font-size: 23px; font-weight: 700; color: #ffffff; }
QLabel#subtitleLabel { color: #b5c2d1; }
QLabel#workspaceLabel { color: #b5c2d1; font-size: 9pt; }
QLabel#globalStatusLabel { background: #123d3b; color: #8ff5e8; border: 1px solid #2b817a; border-radius: 12px; padding: 7px 14px; font-weight: 700; }
QFrame#configurationIntro, QFrame#visualizationCard, QFrame#historyIntroFrame, QFrame#comparisonHeaderFrame, QWidget#detailPanel { background: #121b27; border: 1px solid #263649; border-radius: 10px; }
QLabel#configurationTitleLabel, QLabel#visualizationTitleLabel, QLabel#historyTitleLabel, QLabel#comparisonTitleLabel, QLabel#detailTitleLabel { color: #ffffff; font-size: 16px; font-weight: 700; }
QLabel#configurationDescriptionLabel, QLabel#visualizationHelpLabel, QLabel#historyDescriptionLabel, QLabel#comparisonStatusLabel, QLabel#detailSummaryLabel, QLabel#parameterHelpLabel { color: #b5c2d1; }
QLabel#liveBadgeLabel { background: #322a1b; color: #f5d690; border: 1px solid #766238; border-radius: 9px; padding: 4px 9px; font-size: 9pt; font-weight: 700; }
QLabel#liveBadgeLabel[connected="true"] { background: #123d3b; color: #8ff5e8; border-color: #2b817a; }
QPushButton#fitMapButton, QPushButton#topMapButton { min-height: 21px; padding: 4px 10px; background: #182737; border-color: #37506a; font-size: 9pt; }
QLabel#runStatusLabel { color: #e7eef7; font-weight: 600; padding: 4px 0; }
QProgressBar#runProgressBar { min-height: 18px; background: #0c141e; color: #ffffff; border: 1px solid #3b5069; border-radius: 6px; text-align: center; font-weight: 600; }
QProgressBar#runProgressBar::chunk { background: #159487; border-radius: 5px; }
QLabel#safetyLabel { background: #172334; color: #c9d6e5; border-left: 3px solid #5ca9ff; border-radius: 4px; padding: 9px; }
QTabWidget::pane { border: 1px solid #263649; background: #0f1722; border-radius: 8px; top: -1px; }
QTabBar::tab { background: #111a25; color: #b5c2d1; min-height: 24px; padding: 9px 19px; margin-right: 3px; border: 1px solid #263649; border-bottom: 2px solid transparent; border-top-left-radius: 7px; border-top-right-radius: 7px; }
QTabBar::tab:hover { background: #192638; color: #ffffff; }
QTabBar::tab:selected { background: #1b2a3b; color: #ffffff; border-bottom-color: #3dd6c6; }
QTabBar::tab:disabled { color: #8896a8; background: #101720; }
QGroupBox { background: #121b27; border: 1px solid #2b3c50; border-radius: 10px; margin-top: 16px; padding: 16px 12px 12px 12px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 13px; padding: 0 7px; color: #eaf1f8; background: #121b27; }
QGroupBox:disabled { color: #9ba8b8; border-color: #243245; }
QLabel:disabled, QGroupBox:disabled QLabel { color: #9ba8b8; }
QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit { min-height: 25px; background: #0c141e; color: #f2f7fc; border: 1px solid #3b5069; border-radius: 7px; padding: 5px 9px; selection-background-color: #176d70; selection-color: #ffffff; }
QComboBox:hover, QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QDateEdit:hover { border-color: #607a99; }
QComboBox:focus, QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QPlainTextEdit:focus, QTableWidget:focus { border: 1px solid #4be1d2; }
QComboBox:disabled, QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QDateEdit:disabled { color: #a4b0bf; background: #17202c; border-color: #304054; }
QComboBox QAbstractItemView { background: #111a25; color: #f2f7fc; border: 1px solid #425974; selection-background-color: #176d70; selection-color: #ffffff; outline: 0; }
QPlainTextEdit, QTextBrowser, QTableWidget { background: #0c141e; color: #eaf1f8; border: 1px solid #304258; border-radius: 7px; padding: 5px; selection-background-color: #176d70; selection-color: #ffffff; gridline-color: #263649; alternate-background-color: #111c29; }
QTableWidget::item { color: #eaf1f8; padding: 5px; border: 0; }
QTableWidget::item:selected { background: #176d70; color: #ffffff; }
QPushButton { min-height: 25px; background: #24364b; color: #f7fbff; border: 1px solid #415a75; border-radius: 7px; padding: 6px 14px; font-weight: 600; }
QPushButton:hover { background: #304760; border-color: #6483a5; }
QPushButton:pressed { background: #1b2b3d; }
QPushButton:focus { border: 1px solid #63eadc; }
QPushButton#startButton, QPushButton#compareButton { background: #0e716b; color: #ffffff; border-color: #3dd6c6; }
QPushButton#startButton:hover, QPushButton#compareButton:hover { background: #13867e; }
QPushButton#stopButton { background: #752f3e; color: #ffffff; border-color: #e1687b; }
QPushButton#stopButton:hover { background: #8a3849; }
QPushButton:disabled { color: #9ba8b8; background: #18222f; border-color: #304054; }
QCheckBox { color: #eaf1f8; spacing: 8px; }
QCheckBox::indicator { width: 17px; height: 17px; border: 1px solid #607a99; border-radius: 4px; background: #0c141e; }
QCheckBox::indicator:checked { background: #20a99d; border-color: #55e2d2; }
QHeaderView::section { background: #1a2736; color: #e4edf7; padding: 8px; border: 0; border-right: 1px solid #34475d; border-bottom: 1px solid #34475d; font-weight: 600; }
QSplitter::handle { background: #243449; }
QSplitter::handle:hover { background: #3dd6c6; }
QMenuBar { background: #111a25; color: #dce6f1; border-bottom: 1px solid #263649; }
QMenuBar::item:selected, QMenu::item:selected { background: #176d70; color: #ffffff; }
QMenu { background: #111a25; color: #eaf1f8; border: 1px solid #34475d; }
QStatusBar { background: #111a25; color: #bdcad8; border-top: 1px solid #263649; }
QToolTip { background: #1b2a3b; color: #ffffff; border: 1px solid #607a99; padding: 6px; }
QScrollArea { background: transparent; border: 0; }
QScrollBar:vertical { background: #0f1722; width: 12px; margin: 2px; }
QScrollBar::handle:vertical { background: #435a74; min-height: 28px; border-radius: 5px; }
QScrollBar:horizontal { background: #0f1722; height: 12px; margin: 2px; }
QScrollBar::handle:horizontal { background: #435a74; min-width: 28px; border-radius: 5px; }
QScrollBar::handle:hover { background: #607a99; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QCalendarWidget QWidget { alternate-background-color: #172334; }
QCalendarWidget QAbstractItemView { background: #0c141e; color: #eaf1f8; selection-background-color: #176d70; selection-color: #ffffff; }
QScrollArea#configurationScrollArea, QScrollArea#configurationScrollArea QWidget#qt_scrollarea_viewport, QWidget#configurationPanel { background: #0b1017; }QFrame#navigationFrame, QFrame#treatmentFrame { background: #111a25; border: 1px solid #263649; }
QListWidget#navigationList { background: transparent; border: none; outline: none; font-size: 11pt; }
QListWidget#navigationList::item { color: #b5c2d1; padding: 15px 8px; border-radius: 5px; margin: 3px 0; }
QListWidget#navigationList::item:selected { background: #176d70; color: white; }
QLabel#navigationCaption { color: #839bad; font-size: 8pt; padding: 12px 0; }
QLabel#overviewTitle, QLabel#acquisitionsTitle { font-size: 22px; font-weight: 600; padding: 18px 0 8px; }
QLabel#overviewDescription, QLabel#acquisitionsDescription, QLabel#roadmapLabel { color: #b5c2d1; padding: 8px 0; }
QLabel#overviewCounts { color: #55e2d2; font-size: 15px; padding: 14px 0; }
QLabel#breadcrumbLabel { color: #b5c2d1; padding: 10px; }
QLabel#treatmentLabel { color: #eaf1f8; }
QWidget#overviewPage, QWidget#acquisitionsPage, QStackedWidget#pageStack { background: #0b1017; color: #f2f7fc; }
QLabel { color: #eaf1f8; }
QLabel#overviewTitle, QLabel#acquisitionsTitle { color: #ffffff; }
QLabel#recentLabel { color: #b5c2d1; padding-top: 12px; }
