QWidget { font-family: "Segoe UI", Arial; font-size: 9pt; color: @text@; }
QMainWindow, QWidget#centralWidget, QStackedWidget#pageStack { background: @background@; }
QLabel { background: transparent; }
QFrame#navigationFrame { background: @sidebar@; border-right: 1px solid #dfe7eb; }
QFrame#brandFrame { border-bottom: 1px solid #dfe7eb; padding: 10px 0 18px; }
QLabel#brandIcon { background: @accent@; color: white; border-radius: 8px; font-size: 25px; min-width: 34px; min-height: 34px; }
QLabel#titleLabel { font-size: 15px; font-weight: 700; }
QLabel#subtitleLabel, QLabel#workspaceLabel { color: #778690; font-size: 8pt; }
QLabel#navigationCaption { color: #8b99a3; font-size: 8pt; padding: 20px 5px 10px; }
QLabel#localLabel { color: @accent@; font-weight: 600; border-top: 1px solid #dfe7eb; padding-top: 16px; }
QLabel#safetyLabel { color: #7c898f; font-size: 8pt; padding: 6px 0 10px; }
QListWidget#navigationList { background: transparent; border: 0; outline: none; font-size: 10pt; }
QListWidget#navigationList::item { color: #667985; border: 1px solid transparent; border-radius: 6px; padding: 13px 12px; margin: 3px 0; }
QListWidget#navigationList::item:selected { background: white; color: @accent@; border-color: #dfe7eb; font-weight: 600; }
QListWidget#navigationList::item:hover { background: #ffffff; }
QFrame#headerFrame { background: white; border-bottom: 1px solid #e1e7eb; min-height: 60px; max-height: 60px; }
QLabel#breadcrumbLabel { color: #778690; font-size: 9pt; }
QLabel#environmentBadge { background: #f6f8fa; border: 1px solid #e1e7eb; border-radius: 5px; padding: 6px 10px; color: #778690; font-size: 8pt; }
QPushButton#backButton, QPushButton#settingsShortcut { min-width: 20px; padding: 4px; border: 0; background: transparent; font-size: 16px; }
QTabBar#sectionTabs { background: white; border-bottom: 1px solid #e1e7eb; padding-left: 26px; min-height: 46px; }
QTabBar::tab { background: white; color: #778690; padding: 13px 16px; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: @accent@; border-bottom-color: @accent@; font-weight: 600; }
QTabBar::tab:hover { background: @tint@; }
QWidget#overviewPage { background: @background@; }
QLabel#overviewTitle, QLabel#pageTitle { font-size: 23px; font-weight: 600; }
QLabel#overviewDescription, QLabel#pageDescription, QLabel#recentEmptyLabel, QLabel[class="muted"] { color: #778690; }
QFrame[class="statCard"] { background: white; border: 1px solid #e1e7eb; border-radius: 8px; min-height: 105px; }
QLabel[class="statValue"] { font-size: 25px; font-weight: 600; padding: 5px 0; }
QGroupBox { background: white; border: 1px solid #e1e7eb; border-radius: 8px; margin-top: 15px; padding: 18px 14px 14px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 16px; top: 4px; padding: 0 5px; color: @text@; }
QGroupBox:disabled, QLabel:disabled { color: #8a979e; }
QFrame#configurationIntro, QFrame#visualizationCard, QFrame#historyIntroFrame, QFrame#comparisonHeaderFrame, QWidget#detailPanel { background: white; border: 1px solid #e1e7eb; border-radius: 8px; }
QLabel#configurationTitleLabel, QLabel#visualizationTitleLabel, QLabel#historyTitleLabel, QLabel#comparisonTitleLabel, QLabel#detailTitleLabel { font-size: 17px; font-weight: 600; }
QLabel#configurationDescriptionLabel, QLabel#visualizationHelpLabel, QLabel#historyDescriptionLabel, QLabel#comparisonStatusLabel, QLabel#detailSummaryLabel, QLabel#parameterHelpLabel { color: #778690; }
QLabel#liveBadgeLabel { background: #fff4e6; color: #996a23; border: 1px solid #eddbbd; border-radius: 5px; padding: 4px 8px; font-size: 8pt; }
QLabel#liveBadgeLabel[connected="true"] { background: #e9f6ef; color: #228359; border-color: #c5e6d5; }
QLabel#runStatusLabel { font-weight: 600; padding: 4px 0; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit { background: white; color: @text@; min-height: 24px; border: 1px solid #dbe3e8; border-radius: 5px; padding: 4px 8px; selection-background-color: @accent@; selection-color: white; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QPlainTextEdit:focus, QTableWidget:focus { border-color: @accent@; }
QComboBox QAbstractItemView { background: white; color: @text@; border: 1px solid #dbe3e8; selection-background-color: @tint@; selection-color: @text@; }
QPlainTextEdit, QTextBrowser, QTableWidget, QListWidget { background: white; color: @text@; border: 1px solid #e1e7eb; border-radius: 5px; padding: 4px; selection-background-color: @tint@; selection-color: @text@; alternate-background-color: #f8fafb; gridline-color: #edf1f3; }
QTableWidget::item { padding: 7px 6px; border: 0; }
QTableWidget::item:selected { background: @tint@; color: @text@; }
QHeaderView::section { background: #f8fafb; color: #778690; font-size: 8pt; padding: 9px 7px; border: 0; border-bottom: 1px solid #e1e7eb; font-weight: 600; }
QPushButton { background: white; color: #586877; border: 1px solid #dbe3e8; border-radius: 5px; min-height: 24px; padding: 5px 11px; font-weight: 600; }
QPushButton:hover { background: @tint@; border-color: @accent@; }
QPushButton:pressed { background: @tint@; color: @accent@; }
QPushButton:focus { border-color: @accent@; }
QPushButton#createMissionButton, QPushButton#startButton, QPushButton#compareButton, QPushButton#saveMissionButton, QPushButton#savePreferencesButton, QPushButton[primary="true"] { background: @accent@; color: white; border-color: @accent@; }
QPushButton#stopButton { background: #a44747; color: white; border-color: #a44747; }
QPushButton:disabled { background: #f2f5f6; color: #a0adb4; border-color: #e4e9ec; }
QGroupBox#quickGroup QPushButton { text-align: left; padding: 14px 12px; min-height: 30px; }
QCheckBox { spacing: 7px; }
QCheckBox::indicator { width: 15px; height: 15px; border: 1px solid #bdcbd3; border-radius: 3px; background: white; }
QCheckBox::indicator:checked { background: @accent@; border-color: @accent@; image: url(:/qt-project.org/styles/commonstyle/images/standardbutton-apply-16.png); }
QProgressBar { background: #e8eef0; color: @text@; border: 0; border-radius: 4px; min-height: 9px; text-align: center; }
QProgressBar::chunk { background: @accent@; border-radius: 4px; }
QTabWidget::pane { border: 1px solid #e1e7eb; background: white; border-radius: 5px; }
QSplitter::handle { background: #e1e7eb; }
QSplitter::handle:hover { background: @accent@; }
QScrollArea { background: transparent; border: 0; }
QScrollArea#configurationScrollArea, QScrollArea#configurationScrollArea QWidget#qt_scrollarea_viewport, QWidget#configurationPanel { background: @background@; }
QScrollBar:vertical { background: #f0f3f5; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #bdcbd3; min-height: 28px; border-radius: 4px; }
QScrollBar:horizontal { background: #f0f3f5; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #bdcbd3; min-width: 28px; border-radius: 4px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QFrame#treatmentFrame { background: white; border-top: 1px solid #e1e7eb; padding: 0 16px; }
QLabel#treatmentLabel { color: #778690; font-size: 8pt; }
QStatusBar { background: white; color: #8b99a3; border-top: 1px solid #e1e7eb; font-size: 8pt; }
QMenu, QMenuBar { background: white; color: @text@; }
QMenu::item:selected, QMenuBar::item:selected { background: @tint@; }
QToolTip { background: white; color: @text@; border: 1px solid #bdcbd3; padding: 6px; }
QFrame[panel="true"] { background: white; border: 1px solid #e1e7eb; border-radius: 8px; }
QWidget#missionEditorPanel { background: white; }
QLabel[role="pageTitle"] { font-size: 23px; font-weight: 600; }
QLabel[role="sectionTitle"] { font-size: 13px; font-weight: 600; }
QPushButton[role="primary"] { background: @accent@; color: white; border-color: @accent@; }
QPushButton[role="primary"]:disabled, QPushButton#compareButton:disabled, QPushButton#startButton:disabled {
  background: #f2f5f6; color: #a0adb4; border-color: #e4e9ec;
}
