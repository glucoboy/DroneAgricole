<?xml version="1.0"?>
<package format="3">
  <name>drone_agricole_px4_bridge</name>
  <version>1.0.0</version>
  <description>Pont d'état PX4 en lecture seule et essais offboard SITL verrouillés, en C++17.</description>
  <maintainer email="devnull@example.invalid">Projet Drone Agricole</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
