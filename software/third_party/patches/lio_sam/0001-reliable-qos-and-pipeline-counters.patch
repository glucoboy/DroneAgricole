+    bool imuOrientationValid(const sensor_msgs::msg::Imu& imu)
+    {
+        const auto& q = imu.orientation;
+        const double norm = sqrt(q.x*q.x + q.y*q.y + q.z*q.z + q.w*q.w);
+        if (norm >= 0.1)
+            return true;
+
+        RCLCPP_WARN_THROTTLE(
+            get_logger(), *get_clock(), 5000,
+            "Skipping IMU sample with an invalid orientation quaternion.");
+        return false;
+    }
