+struct PipelineCounters {
+    uint64_t scans_received = 0;
+    uint64_t scans_preprocessed = 0;
+    uint64_t scans_synchronized = 0;
+    uint64_t scans_initialization = 0;
+    uint64_t scans_rejected_undistort_empty = 0;
+    uint64_t scans_map_initialization = 0;
+    uint64_t state_updates = 0;
+    uint64_t odometry_published = 0;
+};
+
+PipelineCounters pipeline_counters;
+rclcpp::Publisher<std_msgs::msg::String>::WeakPtr pipeline_counters_publisher;
+
+void publish_pipeline_counters() {
+    auto publisher = pipeline_counters_publisher.lock();
+    if (!publisher) return;
+    std_msgs::msg::String message;
+    std::ostringstream payload;
+    payload << "{\"schema_version\":1"
+            << ",\"scans_received\":" << pipeline_counters.scans_received
+            << ",\"scans_preprocessed\":" << pipeline_counters.scans_preprocessed
+            << ",\"scans_synchronized\":" << pipeline_counters.scans_synchronized
+            << ",\"scans_initialization\":" << pipeline_counters.scans_initialization
+            << ",\"scans_rejected_undistort_empty\":" << pipeline_counters.scans_rejected_undistort_empty
+            << ",\"scans_map_initialization\":" << pipeline_counters.scans_map_initialization
+            << ",\"scans_rejected_downsample\":0"
+            << ",\"state_updates\":" << pipeline_counters.state_updates
+            << ",\"odometry_published\":" << pipeline_counters.odometry_published
+            << "}";
+    message.data = payload.str();
+    publisher->publish(message);
+}
