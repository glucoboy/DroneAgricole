* text=auto
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.launch.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.pdf binary
*.jpg binary
*.png binary
# Préserver les octets et empreintes des documents fabricants archivés.
hardware/electronique/cartographe/sources_fabricants/** -text -whitespace
# Préserver les octets des instantanés CAO et leurs empreintes de provenance.
hardware/mecanique/cartographe/archives/** -text -whitespace
# Conserver les octets des workers épinglés par le gel H-01.
electromechanical_engine/freecad_worker.py -text
convergence_manager/fixtures/h01_releases/freecad_worker_v2.py -text whitespace=cr-at-eol
# Conserver la forme LF des sources entrées dans le gel du graphe V3.
electromechanical_graph/** text eol=lf
electromechanical_engine/v3_native.py text eol=lf
electromechanical_engine/tests/test_v3_native.py text eol=lf
interconnection_engine/src/Reconcile.* text eol=lf
# Conserver les octets des deux workers référencés dans les preuves V3 B.1.
convergence_manager/native/v3_*.py text eol=lf
# Préserver les deux autorités historiques C4 à leur empreinte d'origine.
docs/electromechanical_v3/bench_b1_c4/criteria.json -text whitespace=cr-at-eol
docs/electromechanical_v3/bench_b1_c4/interface_authority.json -text whitespace=cr-at-eol
# Préserver les empreintes publiées avec les preuves V3-A.2.
electromechanical_engine/v3_a2_native.py text eol=lf
convergence_manager/tests/verify_v3_a2_evidence.py text eol=lf
convergence_manager/tests/test_v3_i_scope.py text eol=lf
# Les reçus de contre-validation B.2 identifient les outils par SHA-256.
convergence_manager/tests/*v3_b2*.py text eol=lf
convergence_manager/tests/replay_v3_c.py text eol=lf
architecture_decision_engine/tests/test_v3_problem.py text eol=lf
docs/verification/v3/c/candidate_trace.jsonl text eol=lf

# Carnet de preuve V3-A.3, octets employés pour la recette et la collecte.
convergence_manager/tests/test_v3_a3_authorities.py text eol=lf
docs/verification/v3/a3/measurement_form.csv text eol=lf
convergence_manager/tests/recheck_v3_d_legacy.py text eol=lf

# Les outils et le journal utilisés par la qualification C.1 sont empreintés.
convergence_manager/tests/*v3_c1*.py text eol=lf
docs/verification/v3/c1/candidate_trace.jsonl text eol=lf
# Préserver les octets attestés par les preuves V3-A.4.
convergence_manager/src/MaterialEvidence.cpp text eol=lf
convergence_manager/tests/test_v3_a4_evidence.py text eol=lf
docs/verification/v3/a4/measurement_form.csv text eol=lf

# Octets des outils et de la trace des campagnes V3-C.2.
convergence_manager/tests/*v3_c2*.py text eol=lf
docs/verification/v3/c2/candidate_trace.jsonl text eol=lf

# Octets des recettes exécutées pour les preuves V3-A.6.
convergence_manager/tests/test_v3_a6_*.py text eol=lf
