  "recette_python": "import hashlib,json,math,os,sys\nfrom pathlib import Path\nimport FreeCAD as App\nimport Part\nroot=Path.cwd()\nbase=root/'hardware/mecanique/cartographe'\nsys.path.insert(0,str(base/'verification'))\nfrom read_brep_prototype import Reader\nproof_path=base/'verification/orch_reprise_vis_fraisees.json'\nproof=json.loads(proof_path.read_text(encoding='utf-8-sig'))\nreader=Reader(base)\nmanifest_path=base/'manifest.json'\nmanifest=json.loads(manifest_path.read_text(encoding='utf-8-sig'))\nrows=[r for r in manifest['prototype_cartographe']['occurrences'] if r['parent'].startswith('sous_assemblages/')]\ndef sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()\nfiles={r['source'] for r in rows}\nfiles.update(['manifest.json','verification/read_brep_prototype.py'])\nhashes={str(base/p):sha(base/p) for p in files}\np60='pieces/fabriquees/P60_Semelle_Batterie_Prototype.FCStd'\np66='pieces/fabriquees/P66_Platine_Avionique_Prototype.FCStd'\nnew_parts={}\ntools=[]\nfor x in (-60,60):\n for y in (-37,37):tools.append(Part.makeCone(1.6,3.46,1.86,App.Vector(x,y,1.14)))\nnew_parts[p60]=reader.shape(p60,'Ensemble').cut(Part.makeCompound(tools)).removeSplitter()\ntools=[]\nfor x in (-66,66):\n for y in (-43,43):tools.append(Part.makeCone(3.46,1.6,1.86,App.Vector(x,y,0)))\nnew_parts[p66]=reader.shape(p66,'Ensemble').cut(Part.makeCompound(tools)).removeSplitter()\nfor length in (16,40):\n f='pieces/commerce/EQ_ISO10642_M3x%d_Prototype.FCStd'%length\n new_parts[f]=Part.makeCylinder(1.5,length,App.Vector(0,0,-length)).fuse(Part.makeCone(1.5,3.36,1.86,App.Vector(0,0,-1.86))).removeSplitter()\ndef key(r):return r['parent']+'#'+r['occurrence']\ndef shape_after(r,shift=True):\n if r['source'] not in new_parts:return reader.occurrence(r)\n s=new_parts[r['source']].copy()\n pose=App.Placement(App.Matrix(*r['matrice']))\n if shift and 'EQ_ISO10642_M3x40' in r['source']:pose.Base.z=-87.1\n if shift and 'EQ_ISO10642_M3x16' in r['source']:pose.Base.z=85.1\n s.Placement=pose.multiply(reader.placement(r['source'],r['objet_source']).inverse()).multiply(s.Placement)\n return s\ndef near(a,b):\n a=a.BoundBox;b=b.BoundBox\n return not(a.XMax<b.XMin-1e-6 or a.XMin>b.XMax+1e-6 or a.YMax<b.YMin-1e-6 or a.YMin>b.YMax+1e-6 or a.ZMax<b.ZMin-1e-6 or a.ZMin>b.ZMax+1e-6)\nold={key(r):reader.occurrence(r) for r in rows}\nnew={key(r):shape_after(r) for r in rows}\nfasteners=[r for r in rows if 'EQ_ISO10642_M3x16_' in r['source'] or 'EQ_ISO10642_M3x40_' in r['source']]\ntests=[];positive=[];evaluated=set();pair_count=0\nfor r in fasteners:\n k=key(r)\n target=p60 if 'M3x40' in r['source'] else p66\n target_row=next(v for v in rows if v['source']==target)\n kt=key(target_row)\n unchanged=shape_after(r,False)\n tests.append({'occurrence':k,'siege':kt,'z_tete_avant_mm':r['matrice'][11],\n 'z_tete_propose_mm':-87.1 if 'M3x40' in r['source'] else 85.1,\n 'volume_intersection_avant_mm3':old[k].common(old[kt]).Volume,\n 'distance_siege_avant_mm':old[k].distToShape(old[kt])[0],\n 'volume_intersection_nouvelles_formes_pose_inchangee_mm3':unchanged.common(new[kt]).Volume,\n 'distance_siege_nouvelles_formes_pose_inchangee_mm':unchanged.distToShape(new[kt])[0],\n 'volume_intersection_apres_mm3':new[k].common(new[kt]).Volume,\n 'distance_siege_apres_mm':new[k].distToShape(new[kt])[0]})\n for t in rows:\n  j=key(t);pair=tuple(sorted((k,j)))\n  if k==j or pair in evaluated:continue\n  evaluated.add(pair)\n  if not(near(old[k],old[j]) or near(new[k],new[j])):continue\n  vb=old[k].common(old[j]).Volume if near(old[k],old[j]) else 0.\n  va=new[k].common(new[j]).Volume if near(new[k],new[j]) else 0.\n  pair_count+=1\n  if vb>1e-6 or va>1e-6:\n   positive.append({'vis':k,'autre':j,'source_autre':t['source'],'volume_avant_mm3':vb,'volume_apres_mm3':va,'delta_mm3':va-vb,\n   'qualification':'Engagement vis/ecrou voulu seulement si identifié ; toute nouvelle intersection positive reste une anomalie.'})\nout={'nombre_occurrences_registre':len(manifest['prototype_cartographe']['occurrences']),'nombre_occurrences_sous_assemblages':len(rows),'nombre_vis':len(fasteners),\n 'nombre_paires_filtrees_bbox':pair_count,'controles_sieges':tests,'intersections_positives':positive,\n 'formes_proposees':[{'source':f,'valide':s.isValid(),'solides':len(s.Solids),'volume_mm3':s.Volume} for f,s in new_parts.items()],\n 'entrees_sha256':{str(Path(p).relative_to(root)).replace('\\\\','/'):h for p,h in hashes.items()},\n 'sources_inchangees':all(sha(p)==h for p,h in hashes.items()),\n 'angle_tete_initial_deg':math.degrees(2*math.atan((3.0-1.5)/1.8)),'angle_tete_propose_deg':90.,\n 'angle_fraisure_initial_deg':math.degrees(2*math.atan((3.1-1.6)/1.8)),'angle_fraisure_propose_deg':90.}\nassert out['sources_inchangees']\nproof['contre_verification_brep']=out\nproof['finalisation_correcte']=True\nproof_path.write_text(json.dumps(proof,ensure_ascii=False,indent=2)+'\\n',encoding='utf-8')\nprint(json.dumps({'vis':len(fasteners),'paires':pair_count,'intersections_positives':len(positive),'sources_inchangees':True}))\nsys.stdout.flush();os._exit(0)\n",
