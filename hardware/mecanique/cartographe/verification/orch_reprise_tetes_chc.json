  "recette_python": "import hashlib,json,os,sys\nfrom pathlib import Path\nimport FreeCAD as App\nimport Part\nroot=Path.cwd()\nbase=root/'hardware/mecanique/cartographe'\nsys.path.insert(0,str(base/'verification'))\nfrom read_brep_prototype import Reader\npath=base/'verification/orch_reprise_tetes_chc.json'\nproof=json.loads(path.read_text(encoding='utf-8-sig'))\nreader=Reader(base)\nmpath=base/'manifest.json'\nm=json.loads(mpath.read_text(encoding='utf-8-sig'))['prototype_cartographe']\nrows=[r for r in m['occurrences'] if r['parent'].startswith('sous_assemblages/')]\ntargets={\n'pieces/commerce/EQ_ISO4762_M2x12_Prototype.FCStd':1.9,\n'pieces/commerce/EQ_ISO4762_M3x55_Prototype.FCStd':2.75,\n'pieces/commerce/EQ_ISO4762_M3x75_Prototype.FCStd':2.75}\ndef sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()\nhashes={str(base/p):sha(base/p) for p in {r['source'] for r in rows}|{'manifest.json','verification/read_brep_prototype.py'}}\nnewparts={};parts=[]\nfor f,radius in targets.items():\n _,objs=reader.xml(f)\n def val(name,param):return float(objs[name][param].find('Float').get('value'))\n height=val('Tete','Height')\n head=Part.makeCylinder(radius,height)\n head.Placement=reader.placement(f,'Tete')\n shaft=reader.shape(f,'Tige')\n shape=shaft.fuse(head).removeSplitter()\n newparts[f]=shape\n old=reader.shape(f,'Ensemble')\n parts.append({'source':f,'objet_modifie':'Tete','parametre':'Radius',\n 'rayon_avant_mm':val('Tete','Radius'),'rayon_apres_mm':radius,\n 'hauteur_tete_mm':height,'longueur_tige_mm':val('Tige','Height'),\n 'diametre_tige_mm':2*val('Tige','Radius'),'valide_apres':shape.isValid(),\n 'solides_apres':len(shape.Solids),'volume_apres_mm3':shape.Volume,\n 'z_min_avant_mm':old.BoundBox.ZMin,'z_max_avant_mm':old.BoundBox.ZMax,\n 'z_min_apres_mm':shape.BoundBox.ZMin,'z_max_apres_mm':shape.BoundBox.ZMax,\n 'placement_tete_inchange':list(reader.placement(f,'Tete').toMatrix().A)})\ndef key(r):return r['parent']+'#'+r['occurrence']\ndef after(r):\n if r['source'] not in targets:return reader.occurrence(r)\n s=newparts[r['source']].copy()\n s.Placement=App.Placement(App.Matrix(*r['matrice'])).multiply(reader.placement(r['source'],r['objet_source']).inverse()).multiply(s.Placement)\n return s\ndef near(a,b):\n a=a.BoundBox;b=b.BoundBox\n return not(a.XMax<b.XMin-1e-6 or a.XMin>b.XMax+1e-6 or a.YMax<b.YMin-1e-6 or a.YMin>b.YMax+1e-6 or a.ZMax<b.ZMin-1e-6 or a.ZMin>b.ZMax+1e-6)\nsolid_cache={}\ndef collision(a,b):\n if not near(a,b):return 0.\n sa=solid_cache.setdefault(id(a),list(a.Solids))\n sb=solid_cache.setdefault(id(b),list(b.Solids))\n if len(sa)>16:\n  aa=[s for s in sa if near(s,b)]\n  if not aa:return 0.\n  a=Part.makeCompound(aa)\n if len(sb)>16:\n  bb=[s for s in sb if near(a,s)]\n  if not bb:return 0.\n  b=Part.makeCompound(bb)\n return a.common(b).Volume\nold={key(r):reader.occurrence(r) for r in rows}\nnew={key(r):after(r) for r in rows}\nfasteners=[r for r in rows if r['source'] in targets]\nevaluated=set();positives=[];n=0;occ=[]\nfor r in fasteners:\n k=key(r);pose=App.Placement(App.Matrix(*r['matrice']))\n axis=pose.Rotation.multVec(App.Vector(0,0,1))\n occ.append({'parent':r['parent'],'occurrence':r['occurrence'],'source':r['source'],'bom_ids':r['bom_ids'],\n 'matrice_inchangee':r['matrice'],'axe_global_inchange':[axis.x,axis.y,axis.z],\n 'z_min_avant_mm':old[k].BoundBox.ZMin,'z_max_avant_mm':old[k].BoundBox.ZMax,\n 'z_min_apres_mm':new[k].BoundBox.ZMin,'z_max_apres_mm':new[k].BoundBox.ZMax,\n 'epaisseur_axiale_inchangee':abs(old[k].BoundBox.ZLength-new[k].BoundBox.ZLength)<1e-9})\n for t in rows:\n  j=key(t);pair=tuple(sorted((k,j)))\n  if k==j or pair in evaluated:continue\n  evaluated.add(pair)\n  if not(near(old[k],old[j]) or near(new[k],new[j])):continue\n  vb=collision(old[k],old[j])\n  va=collision(new[k],new[j])\n  n+=1\n  if vb>1e-6 or va>1e-6:positives.append({'vis':k,'autre':j,'source_autre':t['source'],'volume_avant_mm3':vb,'volume_apres_mm3':va,'delta_mm3':va-vb})\nout={'nombre_occurrences_registre':len(m['occurrences']),'nombre_occurrences_sous_assemblages':len(rows),\n 'nombre_vis_concernees':len(fasteners),'nombre_paires_filtrees_bbox':n,'formes':parts,\n 'occurrences':occ,'intersections_positives':positives,'sources_inchangees':all(sha(p)==h for p,h in hashes.items()),\n 'entrees_sha256':{str(Path(p).relative_to(root)).replace('\\\\','/'):h for p,h in hashes.items()}}\nassert out['sources_inchangees']\nassert all(p['valide_apres'] for p in parts)\nproof['contre_verification_brep']=out\nproof['finalisation_correcte']=True\nproof['conclusion']='Corrections paramétriques compatibles en mémoire sans modification des poses ; toutes les nouvelles intersections positives éventuelles sont conservées dans la preuve.'\npath.write_text(json.dumps(proof,ensure_ascii=False,indent=2)+'\\n',encoding='utf-8')\nprint(json.dumps({'vis':len(fasteners),'paires':n,'intersections_positives':len(positives),'sources_inchangees':True}))\nsys.stdout.flush();os._exit(0)\n",
  "commande_reproduction": "Depuis la racine, le Python fourni avec FreeCAD lit et exécute la clé recette_python de cette preuve. La recette ne sauvegarde aucun natif et actualise seulement contre_verification_brep dans ce fichier.",
