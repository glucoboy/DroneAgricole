(text "ALIMENTATION 3V3 LOCALE"
		(at 259.08 29.21 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "92a7006b-b151-436d-b511-8de4ce21840a")
	)
(text "3V3 : budget 50mA ; P LDO <=0.100W a 5.25V.\nCIN/COUT : Ceff >=0.47uF a verifier sous polarisation.\nF501 : budget total 5V_SYNC 80mA, protection secondaire\n400mA candidate ; appel, chaud et selectivite a verifier."
		(at 259.08 87.63 0)
		(effects
			(font
				(size 1.0 1.0)
			)
			(justify left)
		)
		(uuid "0ddd007e-854c-47ef-b525-2e43c6389e60")
	)
(text "OPTION AIRY SYNC_OUT1 : OUVERTE / DNP"
		(at 259.08 109.22 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "b598c75a-39b4-4d8f-81e9-f7e6f78e1c26")
	)
(text "JP501/2 NC : aucun lien vers la commande camera."
		(at 259.08 144.78 0)
		(effects
			(font
				(size 0.95 0.95)
			)
			(justify left)
		)
		(uuid "5ae85202-5a62-4e88-95d7-671c13882388")
	)
(text "CAMERA : AUX1 -> opto Line1 ; ExposureActive -> CAP1"
		(at 20.32 187.96 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "d959d5d8-54af-4932-a684-b54e56552fae")
	)
(text "Line1 : >5mA requis, <15mA limite en interne.\nQ501 gate 330R / rappel100k ; retour opto distinct de GND GPIO.\nM8 pin2 Line1, pin3 retour commute ; pin4 Line2, pin6 GND.\nPins1/5 NC ; camera alimentee par USB3 externe."
		(at 25.4 251.46 0)
		(effects
			(font
				(size 1.0 1.0)
			)
			(justify left)
		)
		(uuid "0225fb6c-9f67-430a-83b9-89fe18a78a39")
	)
(text "Line2 : rappel 5V via diode ; tampon3V3 tolere 5.5V/Ioff.\nR512 + D502 : protection DC candidate, pas qualification ESD.\n24V : I~4.1mA, P R~80mW ; fronts et temperature a mesurer.\nPixhawk/Orin eteints avec CA01 active : injection reste a verifier.\nCAP1 reserve a exposition, aucun PPS ; polarite/FrameID a valider."
		(at 198.12 268.0 0)
		(effects
			(font
				(size 0.95 0.95)
			)
			(justify left)
		)
		(uuid "a706acaf-9ecd-4272-bf2c-63448d1d1807")
	)
