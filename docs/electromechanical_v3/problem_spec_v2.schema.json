{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drone-agricole:v3.problem_spec:2",
  "title": "Problème de convergence multi-faisceaux",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "phase", "domain_sha256", "model_sha256", "observation_sha256", "seed", "budget", "narrowing", "objectives"],
  "properties": {
    "schema": {"const": "v3.problem_spec/2"},
    "phase": {"enum": ["T0", "T1", "T2", "T3"]},
    "domain_sha256": {"$ref": "#/$defs/sha256"},
    "model_sha256": {"$ref": "#/$defs/sha256"},
    "observation_sha256": {"$ref": "#/$defs/sha256"},
    "base_problem_sha256": {"$ref": "#/$defs/sha256"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_proposals", "max_native", "max_counterchecks", "max_seconds"],
      "properties": {
        "max_proposals": {"type": "integer", "minimum": 3, "maximum": 512},
        "max_native": {"type": "integer", "minimum": 1, "maximum": 16},
        "max_counterchecks": {"type": "integer", "minimum": 1, "maximum": 16},
        "max_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "narrowing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation_mm"],
      "properties": {
        "translation_mm": {
          "type": "object", "additionalProperties": false, "required": ["min", "max"],
          "properties": {"min": {"$ref": "#/$defs/point"}, "max": {"$ref": "#/$defs/point"}}
        },
        "support_zones": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"}
        }
      }
    },
    "objectives": {
      "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/objective"}
    }
  },
  "if": {"properties": {"phase": {"const": "T2"}}},
  "then": {"required": ["base_problem_sha256"]},
  "else": {"not": {"required": ["base_problem_sha256"]}},
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "point": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "objective": {
      "type": "object", "additionalProperties": false, "required": ["metric", "direction", "tolerance"],
      "properties": {
        "metric": {
          "anyOf": [
            {"enum": ["route_length_mm", "service_clearance_mm", "support_count", "route_clearance_mm", "minimum_inter_harness_gap_mm", "minimum_support_bearing_area_mm2", "maximum_forbidden_interference_mm3"]},
            {"type": "string", "pattern": "^harness/[A-Za-z0-9][A-Za-z0-9_.-]{0,79}/(length_mm|clearance_mm|minimum_radius_mm)$"}
          ]
        },
        "direction": {"enum": ["MIN", "MAX"]},
        "tolerance": {
          "type": "number", "exclusiveMinimum": 0,
          "description": "Pas d'arrondi commun aux comparaisons Pareto et au départage par objectif."
        }
      }
    }
  }
}
