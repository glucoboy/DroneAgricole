{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drone-agricole:v3.parametric_domain:4",
  "title": "Domaine synthétique de pose 6DoF, appui plan et deux faisceaux",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "domain",
    "model_id",
    "profile_sha256",
    "move_action",
    "scene",
    "placement",
    "harnesses",
    "support_options",
    "minimum_clearance_mm"
  ],
  "properties": {
    "schema": {
      "const": "v3.parametric_domain/4"
    },
    "domain": {
      "const": "SYNTHETIC_BENCH"
    },
    "model_id": {
      "$ref": "#/$defs/id"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "move_action": {
      "$ref": "#/$defs/id"
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_occurrence",
        "moving_with"
      ],
      "properties": {
        "device_occurrence": {
          "$ref": "#/$defs/path"
        },
        "moving_with": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "translation_min_mm",
        "translation_max_mm",
        "rotation_xyzw",
        "rotation_bounds"
      ],
      "properties": {
        "frame": {
          "const": "ROOT"
        },
        "translation_min_mm": {
          "$ref": "#/$defs/point"
        },
        "translation_max_mm": {
          "$ref": "#/$defs/point"
        },
        "rotation_xyzw": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "rotation_bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "order",
            "min_deg",
            "max_deg"
          ],
          "properties": {
            "order": {
              "const": "ROOT_XYZ"
            },
            "min_deg": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "max_deg": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          },
          "description": "Rotations extrinsèques ROOT X, Y, Z appliquées à la pose nominale. Angles dans [-45,45] degrés sans singularité."
        }
      },
      "description": "Translation ROOT et orientation nominale XYZW. Les bornes sont contrôlées dans le moteur."
    },
    "harnesses": {
      "type": "object",
      "description": "Les clés sont les occurrences de câble dans le profil. Le profil lie les nets, les datums et les réservations aux câbles.",
      "minProperties": 2,
      "maxProperties": 2,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/harness"
      }
    },
    "support_options": {
      "type": "object",
      "description": "Les clés sont les occurrences de support. Une composition scellée contient la pose, tous les câbles par identifiant trié et un seul appui parmi ces options.",
      "minProperties": 1,
      "maxProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/support"
      }
    },
    "minimum_clearance_mm": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(/[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "point": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "length": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corridor_min_mm",
        "corridor_max_mm",
        "start_mm",
        "end_reference_mm",
        "terminal_mode",
        "device_reference_mm",
        "radius_min_mm",
        "radius_max_mm",
        "min_points",
        "max_points",
        "polycorridors",
        "nominal_plane"
      ],
      "properties": {
        "corridor_min_mm": {
          "$ref": "#/$defs/point"
        },
        "corridor_max_mm": {
          "$ref": "#/$defs/point"
        },
        "start_mm": {
          "$ref": "#/$defs/point"
        },
        "end_reference_mm": {
          "$ref": "#/$defs/point"
        },
        "terminal_mode": {
          "const": "NATIVE_PORT"
        },
        "device_reference_mm": {
          "$ref": "#/$defs/point"
        },
        "radius_min_mm": {
          "$ref": "#/$defs/length"
        },
        "radius_max_mm": {
          "$ref": "#/$defs/length"
        },
        "min_points": {
          "type": "integer",
          "minimum": 2,
          "maximum": 16
        },
        "max_points": {
          "type": "integer",
          "minimum": 2,
          "maximum": 16
        },
        "polycorridors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/box"
          },
          "description": "Union de boîtes ROOT, avec au moins un volume positif. Une section nominale peut être surfacique. Le contrôle porte sur l'axe du câble."
        },
        "nominal_plane": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "axis",
            "coordinate_mm"
          ],
          "properties": {
            "axis": {
              "enum": [
                "X",
                "Y",
                "Z"
              ]
            },
            "coordinate_mm": {
              "type": "number"
            }
          }
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "occurrence_path",
        "ports",
        "route",
        "diameter_mm",
        "electrical_id",
        "minimum_length_mm",
        "maximum_length_mm",
        "evidence_scope"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/id"
        },
        "occurrence_path": {
          "$ref": "#/$defs/path"
        },
        "ports": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "diameter_mm": {
          "$ref": "#/$defs/length"
        },
        "electrical_id": {
          "$ref": "#/$defs/id"
        },
        "minimum_length_mm": {
          "$ref": "#/$defs/length"
        },
        "maximum_length_mm": {
          "$ref": "#/$defs/length"
        },
        "evidence_scope": {
          "const": "SYNTHETIC_BENCH"
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "operation",
        "occurrence",
        "anchor",
        "anchor_path",
        "support_path",
        "carrier_path",
        "anchor_zone",
        "offset_patch_mm",
        "min_carrier_thickness_mm"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/id"
        },
        "operation": {
          "const": "RELOCATE_SUPPORT"
        },
        "occurrence": {
          "$ref": "#/$defs/id"
        },
        "anchor": {
          "$ref": "#/$defs/id"
        },
        "anchor_path": {
          "$ref": "#/$defs/path"
        },
        "support_path": {
          "$ref": "#/$defs/path"
        },
        "carrier_path": {
          "$ref": "#/$defs/path"
        },
        "anchor_zone": {
          "$ref": "#/$defs/box"
        },
        "offset_patch_mm": {
          "$ref": "#/$defs/box",
          "description": "Point de l’appui dans le repère de son ancrage, avec deux dimensions strictement positives et Z=0."
        },
        "min_carrier_thickness_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_mm",
        "max_mm"
      ],
      "properties": {
        "min_mm": {
          "$ref": "#/$defs/point"
        },
        "max_mm": {
          "$ref": "#/$defs/point"
        }
      }
    }
  }
}
