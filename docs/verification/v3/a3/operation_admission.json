    "BMS_USB_STRUCTURE_ISOLATION": {
      "status": "REQUIRED",
      "applicable_physical_evidence": "UNKNOWN",
      "source": "docs/verification/v3/a2/operation_scopes.json#/non_relaxable_constraints/BMS_USB_STRUCTURE_ISOLATION",
      "definition": "Le retour B− brut reste confiné au côté TTL isolé. Interdire tout pont vers GND USB, blindage USB, retours avioniques ou structure, ainsi que tout chemin de faisceau ou de fixation contournant le BMS entre B− brut et P− protégé."
    },
    "NC": {
      "status": "REQUIRED",
      "applicable_physical_evidence": "UNKNOWN",
      "source": "docs/verification/v3/a2/operation_scopes.json#/non_relaxable_constraints/NC",
      "definition": "VDD BMS et VCC TTL restent non connectés."
    },
    "TX_RX": {
      "status": "REQUIRED",
      "applicable_physical_evidence": "UNKNOWN",
      "source": "docs/verification/v3/a2/operation_scopes.json#/non_relaxable_constraints/TX_RX",
      "definition": "Conserver le croisement des fonctions TX/RX et le retour dédié."
    },
    "PROTECTIONS": {
      "status": "REQUIRED",
      "applicable_physical_evidence": "UNKNOWN",
      "source": "docs/verification/v3/a2/operation_scopes.json#/non_relaxable_constraints/PROTECTIONS",
      "definition": "Conserver PM08/CAN1, les protections MIDI/CA01, les chemins protégés de puissance et l'autorité PX4."
    },
    "PINOUT": {
      "status": "REQUIRED",
      "applicable_physical_evidence": "UNKNOWN",
      "source": "docs/verification/v3/a2/operation_scopes.json#/non_relaxable_constraints/PINOUT",
      "definition": "Appliquer la preuve orientée de la révision montée, avec indexage des cavités et contrôle des continuités."
    },
    "INDEPENDENT_FRAMES": {
      "status": "REQUIRED",
      "applicable_physical_evidence": "UNKNOWN",
      "source": "docs/verification/v3/a2/operation_scopes.json#/non_relaxable_constraints/INDEPENDENT_FRAMES",
      "definition": "Utiliser des repères indépendants pour embase, fiche, accouplement, sortie et geste. Les axes F40/F41 décrivent les chemins virtuels."
    },
    "GEOMETRY": {
      "status": "REQUIRED",
      "applicable_physical_evidence": "UNKNOWN",
      "source": "docs/verification/v3/a2/operation_scopes.json#/non_relaxable_constraints/GEOMETRY",
      "definition": "Résoudre les XLinks et vérifier les solides, dégagements, tolérances et voisinages concernés."
    },
    "SUPPORT_ANCHOR": {
      "status": "REQUIRED",
      "applicable_physical_evidence": "UNKNOWN",
      "source": "docs/verification/v3/a2/operation_scopes.json#/non_relaxable_constraints/SUPPORT_ANCHOR",
      "definition": "Exiger un appui effectif, un engagement de fixation et un chemin d'effort démontré avant admission."
    },
    "SERVICE": {
      "status": "REQUIRED",
      "applicable_physical_evidence": "UNKNOWN",
      "source": "docs/verification/v3/a2/operation_scopes.json#/non_relaxable_constraints/SERVICE",
      "definition": "Préserver accès TTL, USB-B, hôte USB et maintien des réserves, ainsi que le retrait batterie avec séquence hors tension."
    },
    "IMMUTABLE_SOURCES": {
      "status": "REQUIRED",
      "applicable_physical_evidence": "UNKNOWN",
      "source": "docs/verification/v3/a2/operation_scopes.json#/non_relaxable_constraints/IMMUTABLE_SOURCES",
      "definition": "Ne modifier que la copie privée autorisée. La transaction est bornée à une opération et une occurrence, avec abandon de la copie en cas de refus."
    },
    "DYNAMIC_BEND_RADIUS": {
      "status": "REQUIRED",
