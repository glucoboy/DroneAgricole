    "a5_command": "python -B convergence_manager/tests/test_v3_a5_authority.py --core ../int4/build/l5/convergence_core.exe --openssl C:/msys64/ucrt64/bin/openssl.exe --out ../int4/boundary/a5-adversarial.json",
    "int3_common_arguments": "--core ../int4/build/l5/convergence_core.exe --openssl C:/msys64/ucrt64/bin/openssl.exe --freecad <FreeCAD Python> --t0 .runtime/i4t0/cartographe-evidence.exe --c3-plan .runtime/b4/c3/proposal.json --c3-transaction .runtime/b4/c3/transaction --tested-commit <SHA INT.4>",
