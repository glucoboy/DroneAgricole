      "encoding": "UTF-8 sans BOM et saut de ligne final LF",
      "source_lines": [
        "\"\"\"Rejoue les passages entre preuves documentaires A.7 et bancs CAO C.4/A.6.\"\"\"",
        "import argparse",
        "from pathlib import Path",
        "import shutil",
        "import subprocess",
        "import sys",
        "",
        "ROOT = Path.cwd().resolve()",
        "PRIVATE = ROOT / \".runtime/b4\"",
        "EVIDENCE = ROOT.parent / \"int4/boundary\"",
        "sys.path[:0] = [str(ROOT / \"convergence_manager/tests\"),",
        "                str(ROOT / \"docs/verification/v3/int3/independent/recipes\")]",
        "",
        "from recheck_boundaries import files, reject",
        "from test_v3_a5_authority import data, read, save, sha, stamp",
        "from test_v3_a6_transactions import A6Fixture, SigningFixtures",
        "import test_v3_a7_reception as a7",
        "",
        "APPS = ROOT.parent / \"int4/build/l5\"",
        "CORE = APPS / \"convergence_core.exe\"",
        "RECEPTION = APPS / \"cartographe_reception.exe\"",
        "TOOLS = (\"--freecad-python\", \"C:/Program Files/FreeCAD 1.1/bin/python.exe\",",
        "         \"--t0-validator\", ROOT / \".runtime/i4t0/cartographe-evidence.exe\")",
        "",
        "",
        "def digest(path):",
        "    return sha(path.read_bytes())",
        "",
        "",
        "def invoke(label, command, expected):",
        "    result = subprocess.run(list(map(str, command)), capture_output=True, timeout=45)",
        "    for stream in (\"stdout\", \"stderr\"):",
        "        (EVIDENCE / f\"{label}.{stream}.log\").write_bytes(getattr(result, stream))",
        "    save(EVIDENCE / f\"{label}.command.json\", {\"argv\": list(map(str, command)),",
        "                                              \"exit_code\": result.returncode})",
        "    assert result.returncode == expected, (label, result.stderr)",
        "    return result",
        "",
        "",
        "def intake():",
        "    area = PRIVATE / \"a7\"",
        "    area.mkdir()",
        "    matrix = read(a7.MATRIX_PATH)",
        "    receipts = {}",
        "    for carrier in (\"P64\", \"P66\"):",
        "        case = area / carrier",
        "        raw, packet, submission, policy = a7.private_bundle(case, matrix, carrier)",
        "        policy_path = case / \"policy.json\"",
        "        policy_sha = a7.write(policy_path, policy)",
        "        submission[\"packet\"] = {\"path\": \"packet.json\", \"sha256\": a7.write(raw / \"packet.json\", packet)}",
        "        current = a7.write(raw / \"submission.json\", submission)",
        "        settings = [\"--raw-root\", raw, \"--submission\", \"submission.json\", \"--current-sha256\", current,",
        "                    \"--policy\", policy_path, \"--policy-sha256\", policy_sha]",
        "        response = invoke(f\"reception-{carrier}\", [RECEPTION, \"--matrix\", a7.MATRIX_PATH, *settings], 0)",
        "        receipt = case / \"receipt.json\"",
        "        receipt.write_bytes(response.stdout)",
        "        report = read(receipt)",
        "        a7.rights(report)",
        "        assert report[\"status\"] == \"ANALYZED\"",
        "        counter = invoke(f\"contre-lecture-{carrier}\", [",
        "            sys.executable, \"-B\", a7.SOURCE_CHECK, \"--matrix\", a7.MATRIX_PATH, \"--receipt\", receipt, *settings], 0)",
        "        counter_path = case / \"countercheck.json\"",
        "        counter_path.write_bytes(counter.stdout)",
        "        counter = read(counter_path)",
        "        assert counter[\"checked_measurements\"] == 27 and counter[\"receipt_sha256\"] == digest(receipt)",
        "        assert counter[\"authority\"] == \"DENY\"",
        "        receipts[carrier] = {\"request_sha256\": current, \"packet_sha256\": digest(raw / \"packet.json\"),",
        "                             \"policy_sha256\": policy_sha, \"independent\": counter}",
        "    save(EVIDENCE / \"a7-inputs-for-cross.json\", receipts)",
        "",
        "",
        "def cross(campaign_root):",
        "    area = PRIVATE / \"cross\"",
        "    area.mkdir()",
        "    keys, logs = area / \"keys\", area / \"logs\"",
        "    keys.mkdir()",
        "    logs.mkdir()",
        "    fixture = A6Fixture(CORE, area / \"workholding\",",
        "                        SigningFixtures(Path(\"C:/msys64/ucrt64/bin/openssl.exe\"), keys))",
        "    freeze_path = campaign_root / \"freeze.json\"",
        "    frozen = read(freeze_path)[\"t1\"][\"candidate\"]",
        "    source_entry = ROOT / frozen[\"path\"]",
        "    assert digest(source_entry) == frozen[\"sha256\"]",
        "    native_dir = source_entry.parent",
        "    transaction = native_dir.parent",
        "    original_plan = transaction / \"mutation-plan.json\"",
        "    native = files(native_dir, \"*.FCStd\")",
        "    witness = read(transaction / \"campaign.json\")",
        "    assert witness[\"status\"] == \"PASS\" and witness[\"execution_scope\"] == \"BENCH_TEST_ONLY\"",
        "    assert native == witness[\"native_sha256\"] == read(transaction / \"candidate-job.json\")[\"dependencies\"]",
        "    assert digest(original_plan) == witness[\"plan_sha256\"]",
        "    cad = area / \"c4-cad\"",
        "    shutil.copytree(native_dir, cad)",
        "    plan_path = area / \"c4-plan.json\"",
        "    shutil.copyfile(original_plan, plan_path)",
        "    plan = read(plan_path)",
        "    assert files(cad, \"*.FCStd\") == native",
        "    assert len(plan[\"values\"][\"harnesses\"]) == 2 and len(plan[\"values\"][\"rotation_xyzw\"]) == 4",
        "    rows = {}",
        "",
        "    def case(name, reason, **options):",
        "        rows[name] = reject(logs, fixture, name, reason, **options)",
        "        save(EVIDENCE / \"cross.partial.json\", rows)",
        "",
        "    case(\"c4-6dof-on-a6-entry\", \"Contrat d'admission A.5 requis\", cli=True, path=plan_path, sandbox=cad, extra=TOOLS)",
        "    case(\"a6-output-overlapping-c4-native-closure\", \"A6_OUTPUT_NOT_PRIVATE_OR_OVERLAPPING\", cli=True,",
        "         sandbox=cad, output=cad / \"inadmissible\")",
        "    case(\"c4-harnesses-added-to-signed-a6-effect\", \"SIGNED_NATIVE_EFFECT_OR_PACKAGE_MISMATCH\",",
        "         request={**fixture.request, \"effect\": {**fixture.request[\"effect\"], \"harnesses\": plan[\"values\"][\"harnesses\"]}})",
        "    for carrier in (\"P64\", \"P66\"):",
        "        received = PRIVATE / \"a7\" / carrier / \"receipt.json\"",
        "        a7.rights(read(received))",
        "        substitute = fixture.raw / f\"reception-{carrier}.json\"",
        "        shutil.copyfile(received, substitute)",
        "        substituted = {**fixture.request, \"submission\": {**fixture.request[\"submission\"], \"review\": substitute.name}}",
        "        case(f\"a7-{carrier}-reception-used-as-signed-review\", \"CONTRACT_FIELDS_MISMATCH\", request=substituted)",
        "        case(f\"a7-{carrier}-reception-used-as-physical-authority\", \"PHYSICAL_ADMISSION_NOT_CONFIGURED\",",
        "             request={**substituted, \"evidence_class\": \"PHYSICAL_MEASURED\", \"domain\": \"CARTOGRAPHER_PRIVATE_CAD\"})",
        "    replaced_lot = read(PRIVATE / \"a7/P66/policy.json\")[\"identities\"]",
        "    case(\"a7-p66-lot-identity-substitution\", \"TRUST_BINDING_MISMATCH\",",
        "         request={**fixture.request, \"bindings\": {**fixture.request[\"bindings\"], \"lot_sha256\": sha(data(replaced_lot))}})",
        "    case(\"c4-plan-digest-substituted-for-a6-trust-pin\", \"TRUST_SHA256_MISMATCH\", pin=digest(plan_path))",
        "    fixture.prepare(expires_at_utc=stamp(-1))",
        "    case(\"expired-signed-decision-after-documentary-reception\", \"REVIEW_EXPIRED_OR_IN_FUTURE\")",
        "    fixture.prepare()",
        "    packet = fixture.packet.read_bytes()",
        "    fixture.packet.write_bytes(packet + b\"\\n\")",
        "    case(\"signed-packet-with-altered-bytes\", \"SIGNED_REVIEW_BINDING_MISMATCH\")",
        "    fixture.packet.write_bytes(packet)",
        "",
        "    escalated = area / \"c4-physical-plan.json\"",
        "    save(escalated, {**plan, \"domain\": \"CARTOGRAPHER_PRIVATE_CAD\"})",
        "    out = area / \"no-cartographer\"",
        "    active = ROOT / \"hardware/mecanique/cartographe\"",
        "    invoke(\"c4-active-cartographer-refusal\", [CORE, \"v3-build\", \"--root\", ROOT, \"--request\", escalated,",
        "           \"--sandbox\", active, \"--output\", out, *TOOLS], 2)",
        "    refused = read(out / \"refusal.json\")",
        "    assert refused[\"reason\"] == \"MUTATION_DOMAIN_DENIED\" and refused[\"construction_result\"] == \"NOT_RUN\"",
        "    assert refused[\"candidate_transactions\"] == 0 and refused[\"execution_scope\"] == \"NONE\"",
        "    assert set(files(out)) == {\"refusal.json\"}",
        "    rows[\"c4-constructor-on-active-cartographer\"] = {\"status\": \"PASS\", \"reason\": refused[\"reason\"],",
        "        \"new_authorized_native_execution\": False, \"new_private_native_files\": 0,",
        "        \"receipt_sha256\": digest(out / \"refusal.json\")}",
        "",
        "    raw = PRIVATE / \"a7/P64/raw\"",
        "    imported = raw / \"v3-c4-plan.json\"",
        "    shutil.copyfile(plan_path, imported)",
        "    policy = raw.parent / \"policy.json\"",
        "    result = invoke(\"c4-plan-as-a7-submission\", [RECEPTION, \"--matrix\", a7.MATRIX_PATH, \"--raw-root\", raw,",
        "        \"--submission\", imported.name, \"--current-sha256\", digest(imported), \"--policy\", policy,",
        "        \"--policy-sha256\", digest(policy)], 2)",
        "    assert b\"A7_INVALID_SUBMISSION_FIELDS\" in result.stderr",
        "    rows[\"c4-plan-as-a7-submission\"] = {\"status\": \"PASS\", \"reason\": \"A7_INVALID_SUBMISSION_FIELDS\",",
        "        \"new_authorized_native_execution\": False, \"new_private_native_files\": 0, \"request_sha256\": digest(imported)}",
        "    assert digest(plan_path) == digest(original_plan) and files(cad, \"*.FCStd\") == native == files(native_dir, \"*.FCStd\")",
        "    assert fixture.journal_states() == []",
        "    save(EVIDENCE / \"cross.json\", {\"status\": \"PASS\", \"case_count\": len(rows), \"cases\": rows,",
        "        \"c4_t1\": {\"freeze_sha256\": digest(freeze_path), \"plan_sha256\": digest(original_plan), \"native_sha256\": native}})",
        "",
        "",
        "parser = argparse.ArgumentParser(description=__doc__)",
        "parser.add_argument(\"phase\", choices=(\"intake\", \"cross\"))",
        "parser.add_argument(\"--commit\", required=True)",
        "parser.add_argument(\"--campaign\", type=Path, default=ROOT / \".runtime/i4n\")",
        "args = parser.parse_args()",
        "assert args.commit == subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True).strip()",
        "subprocess.run([\"git\", \"diff\", \"--quiet\", \"HEAD\", \"--\"], check=True)",
        "if args.phase == \"intake\":",
        "    intake()",
        "else:",
        "    cross(args.campaign)",
        ""
      ]
    },
    "cross_commands": [
      "python -B ../int4/boundary/replay_cross.py intake --commit <SHA INT.4>",
      "python -B ../int4/boundary/replay_cross.py cross --commit <SHA INT.4> --campaign .runtime/i4n"
    ],
    "t2_evaluator": {
      "file": {
        "path": ".runtime/int4/boundary/evaluate_int4_t2.py",
        "bytes": 2201,
        "sha256": "309505be6478288885ec28c2f62bf9ce6f50e94b65fb4f2c098bc973e6253b82"
      },
      "encoding": "UTF-8 sans BOM et saut de ligne final LF",
      "source_lines": [
        "\"\"\"Choix géométrique indépendant de l'obstacle neuf de V3-INT.4.\"\"\"",
        "from datetime import datetime, timezone",
        "import importlib.util",
        "from pathlib import Path",
        "import subprocess",
        "",
        "",
        "root = Path.cwd().resolve()",
        "commit = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True).strip()",
        "handoff_path = root / \".runtime/i4n/T2-HANDOFF.json\"",
        "profile = root / \"docs/electromechanical_v3/bench_c4_sixdof/profile.json\"",
        "freecad = Path(\"C:/Program Files/FreeCAD 1.1/bin/python.exe\")",
        "output = root / \".runtime/i4e\"",
        "module = importlib.util.spec_from_file_location(\"historical_evaluator\", root / \"docs/verification/v3/c4/evaluate_t2.py\")",
        "evaluator = importlib.util.module_from_spec(module)",
        "module.loader.exec_module(evaluator)",
        "freeze = evaluator.read(root / evaluator.read(handoff_path)[\"freeze\"][\"path\"])",
        "assert commit == freeze[\"inputs\"][\"tested_commit\"] == \"48245a446b949e92995e2aeb6a9dd2fdf7b55017\"",
        "assert datetime.fromisoformat(freeze[\"frozen_at_utc\"]) < datetime.now(timezone.utc)",
        "",
        "",
        "def choose_new_box(routes):",
        "    # Le premier obstacle C.4 visait cordon. Le milieu de la pente de cordon-b",
        "    # offre ici un défi distinct, loin des embases et des arcs.",
        "    harness = \"cordon-b\"",
        "    edge = routes[harness][\"edges\"][2]",
        "    assert edge[\"type\"] == \"Line\" and edge[\"length_mm\"] > 30",
        "    fraction = 0.35",
        "    center = [first + fraction * (last - first) for first, last in zip(edge[\"start_mm\"], edge[\"end_mm\"], strict=True)]",
        "    half_size = (0.47, 0.31, 0.26)",
        "    obstacle = {\"id\": \"Int4CordonBInclinedSpan\",",
        "        \"min_mm\": [round(coordinate - half, 3) for coordinate, half in zip(center, half_size, strict=True)],",
        "        \"max_mm\": [round(coordinate + half, 3) for coordinate, half in zip(center, half_size, strict=True)]}",
        "    historic = evaluator.read(root / \"docs/verification/v3/c4/external_input.json\")[\"obstacle\"]",
        "    assert any(old_max < new_min or new_max < old_min",
        "               for old_min, old_max, new_min, new_max in zip(historic[\"min_mm\"], historic[\"max_mm\"],",
        "                   obstacle[\"min_mm\"], obstacle[\"max_mm\"], strict=True))",
        "    return harness, edge, fraction, center, obstacle",
        "",
        "",
        "evaluator.choose_box = choose_new_box",
        "evaluator.evaluate(root, handoff_path, output, profile, freecad)",
        ""
      ]
    },
    "t2_command": "Après remise du handoff T1 et vérification du SHA gelé, émettre le nouvel obstacle avec python -B ../int4/boundary/evaluate_int4_t2.py depuis le worktree. Communiquer son SHA-256 au constructeur hors du fichier."
  }
