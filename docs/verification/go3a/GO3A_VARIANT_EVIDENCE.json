    "plateforme": "Windows amd64, Qt 6.11.2 UCRT64, binaires GO2bis identiques par SHA-256",
    "commandes": [
      "$env:PATH = 'C:/msys64/ucrt64/bin;' + $env:PATH",
      "$oracle = Get-Content -Raw '.runtime/go2bis-l3-l5/l3-authority/oracle.json' | ConvertFrom-Json",
      "$dst = '.runtime/go3a-variants-l3-rejeu'",
      "foreach ($case in $oracle.tests) { & $oracle.frozen[0].path --l1 $oracle.frozen[1].path --output (Join-Path $dst $case.id) --benches $case.input.path --requirements $oracle.frozen[3].path --acceptance $oracle.frozen[4].path; if ($LASTEXITCODE -ne $case.exit) { throw 'Code L3 différent de l’oracle' }; & $oracle.frozen[2].path validate (Join-Path $dst $case.id) .; if ($LASTEXITCODE -ne 0) { throw 'Preuve T0 invalide' } }"
    ],
    "reproduction": "Créer le dossier parent neuf $dst. Vérifier au préalable le SHA-256 de l’oracle, des cinq entrées gelées et des trois bancs. Comparer le statut de chaque candidat dans candidates/ avec la clé checks de son cas oracle. Les chemins de sortie et les horodatages changent les empreintes du rejeu.",
    "resultat_brut": {
      "path": ".runtime/go3a-variants-l3/receipt.json",
      "sha256": "e2ba690ca3e0e8194565c445e34f9977aa589a0dbeca2c47fa92a980e56e12c3"
    },
