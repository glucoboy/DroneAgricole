{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contrats de données du moteur électromécanique V2",
  "type": "object",
  "required": ["schema_version","configuration_id","scope","frames","states","records"],
  "properties": {"schema_version":{"const":"2.0.0"},"configuration_id":{"$ref":"#/$defs/Id"},"scope":{"enum":["SYNTHETIC","CARTOGRAPHE"]},"frames":{"type":"array","items":{"$ref":"#/$defs/Frame"},"minItems":1,"uniqueItems":true},"states":{"type":"array","items":{"$ref":"#/$defs/State"},"minItems":1,"uniqueItems":true},"records":{"type":"object","required":["equipment","ports","connector_receptacles","connector_mates","contacts","pins","circuits","cables","harness_segments","routes","mechanical_interfaces","requirements","research_questions","technical_evidence","engineering_decisions","candidates","validation_findings","validation_reports","terminals","mechanical_nodes"],"properties":{"equipment":{"type":"array","items":{"$ref":"#/$defs/Equipment"},"minItems":0,"uniqueItems":true},"ports":{"type":"array","items":{"$ref":"#/$defs/Port"},"minItems":0,"uniqueItems":true},"connector_receptacles":{"type":"array","items":{"$ref":"#/$defs/ConnectorReceptacle"},"minItems":0,"uniqueItems":true},"connector_mates":{"type":"array","items":{"$ref":"#/$defs/ConnectorMate"},"minItems":0,"uniqueItems":true},"contacts":{"type":"array","items":{"$ref":"#/$defs/Contact"},"minItems":0,"uniqueItems":true},"pins":{"type":"array","items":{"$ref":"#/$defs/Pin"},"minItems":0,"uniqueItems":true},"circuits":{"type":"array","items":{"$ref":"#/$defs/Circuit"},"minItems":0,"uniqueItems":true},"cables":{"type":"array","items":{"$ref":"#/$defs/Cable"},"minItems":0,"uniqueItems":true},"harness_segments":{"type":"array","items":{"$ref":"#/$defs/HarnessSegment"},"minItems":0,"uniqueItems":true},"routes":{"type":"array","items":{"$ref":"#/$defs/Route"},"minItems":0,"uniqueItems":true},"mechanical_interfaces":{"type":"array","items":{"$ref":"#/$defs/MechanicalInterface"},"minItems":0,"uniqueItems":true},"requirements":{"type":"array","items":{"$ref":"#/$defs/Requirement"},"minItems":0,"uniqueItems":true},"research_questions":{"type":"array","items":{"$ref":"#/$defs/ResearchQuestion"},"minItems":0,"uniqueItems":true},"technical_evidence":{"type":"array","items":{"$ref":"#/$defs/TechnicalEvidence"},"minItems":0,"uniqueItems":true},"engineering_decisions":{"type":"array","items":{"$ref":"#/$defs/EngineeringDecision"},"minItems":0,"uniqueItems":true},"candidates":{"type":"array","items":{"$ref":"#/$defs/Candidate"},"minItems":0,"uniqueItems":true},"validation_findings":{"type":"array","items":{"$ref":"#/$defs/ValidationFinding"},"minItems":0,"uniqueItems":true},"validation_reports":{"type":"array","items":{"$ref":"#/$defs/ValidationReport"},"minItems":0,"uniqueItems":true},"terminals":{"type":"array","items":{"$ref":"#/$defs/Terminal"},"minItems":0,"uniqueItems":true},"mechanical_nodes":{"type":"array","items":{"$ref":"#/$defs/MechanicalNode"},"minItems":0,"uniqueItems":true}},"additionalProperties":false}},
  "additionalProperties": false,
  "$defs": {
    "Id": {"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "Sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "Vector3": {"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3},
    "Matrix4": {"type":"array","items":{"type":"array","items":{"type":"number"},"minItems":4,"maxItems":4},"minItems":4,"maxItems":4},
    "Value": {
      "type": "object",
      "required": ["value","unit","status","evidence_ids","revision","collected_at","precision","uncertainty","method","input_value_refs","limits"],
      "properties": {
        "value": {"type":["number","string","boolean","null"]},
        "unit": {"enum":["mm","mm2","mm3","deg","A","V","ohm","Hz","s","degC","g","g/m","1"]},
        "status": {"enum":["SOURCED","MEASURED","CALCULATED","ESTIMATED","ASSUMED","UNKNOWN"]},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true},
        "revision": {"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
        "collected_at": {"type":"string","format":"date-time","pattern":"Z$"},
        "precision": {"anyOf":[{"type":"number","exclusiveMinimum":0},{"type":"null"}]},
        "uncertainty": {"anyOf":[{"type":"number","minimum":0},{"type":"null"}]},
        "method": {"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
        "input_value_refs": {"type":"array","items":{"type":"string","pattern":"^/"},"minItems":0,"uniqueItems":true},
        "limits": {"type":"string","minLength":1}
      },
      "additionalProperties": false,
      "allOf": [
        {"if":{"properties":{"status":{"const":"UNKNOWN"}}},"then":{"properties":{"value":{"type":"null"},"precision":{"type":"null"},"uncertainty":{"type":"null"}}},"else":{"properties":{"value":{"not":{"type":"null"}}}}},
        {"if":{"properties":{"status":{"enum":["SOURCED","MEASURED"]}}},"then":{"properties":{"evidence_ids":{"minItems":1}}}},
        {"if":{"properties":{"status":{"enum":["MEASURED","CALCULATED","ESTIMATED","ASSUMED"]}}},"then":{"properties":{"method":{"type":"string","minLength":1}}}},
        {"if":{"properties":{"status":{"const":"CALCULATED"}}},"then":{"properties":{"input_value_refs":{"minItems":1}}}}
      ]
    },
    "Frame": {
      "type": "object",
      "required": ["id","parent_frame_id","parent_from_local","native_anchor","evidence_ids"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "parent_frame_id": {"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
        "parent_from_local": {"anyOf":[{"$ref":"#/$defs/Matrix4"},{"type":"null"}]},
        "native_anchor": {"anyOf":[{"$ref":"#/$defs/NativeAnchor"},{"type":"null"}]},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true}
      },
      "additionalProperties": false
    },
    "State": {
      "type": "object",
      "required": ["id","description","evidence_ids","frame_overrides"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "description": {"type":"string","minLength":1},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true},
        "frame_overrides": {"type":"array","uniqueItems":true,"items":{"type":"object","required":["frame_id","parent_from_local","evidence_ids"],"properties":{"frame_id":{"$ref":"#/$defs/Id"},"parent_from_local":{"anyOf":[{"$ref":"#/$defs/Matrix4"},{"type":"null"}]},"evidence_ids":{"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true}},"additionalProperties":false}}
      },
      "additionalProperties": false
    },
    "NativeAnchor": {
      "type": "object",
      "required": ["evidence_id","object_name","occurrence_path","subelement"],
      "properties": {
        "evidence_id": {"$ref":"#/$defs/Id"},
        "object_name": {"type":"string","minLength":1},
        "occurrence_path": {"type":"array","items":{"type":"string","minLength":1}},
        "subelement": {"anyOf":[{"type":"string","minLength":1},{"type":"null"}]}
      },
      "additionalProperties": false
    },
    "Terminal": {
      "type": "object",
      "required": ["id","kind","contact_id","evidence_ids","end_id"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "kind": {"enum":["CONTACT","FREE_END","JUNCTION"]},
        "contact_id": {"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true},
        "end_id": {"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]}
      },
      "additionalProperties": false,
      "allOf": [
        {"if":{"properties":{"kind":{"const":"CONTACT"}}},"then":{"properties":{"contact_id":{"$ref":"#/$defs/Id"}}}},
        {"if":{"properties":{"kind":{"enum":["JUNCTION","FREE_END"]}}},"then":{"properties":{"contact_id":{"type":"null"}}}},
        {"if":{"properties":{"kind":{"const":"FREE_END"}}},"then":{"properties":{"end_id":{"$ref":"#/$defs/Id"}}}}
      ]
    },
    "MechanicalNode": {
      "type": "object",
      "required": ["id","frame_id","point_mm","evidence_ids"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "frame_id": {"$ref":"#/$defs/Id"},
        "point_mm": {"anyOf":[{"$ref":"#/$defs/Vector3"},{"type":"null"}]},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true}
      },
      "additionalProperties": false
    },
    "Span": {
      "type": "object",
      "required": ["cable_id","conductor_id"],
      "properties": {
        "cable_id": {"$ref":"#/$defs/Id"},
        "conductor_id": {"$ref":"#/$defs/Id"}
      },
      "additionalProperties": false
    },
    "Conductor": {
      "type": "object",
      "required": ["id","role","terminal_ids","section_mm2"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "role": {"enum":["SIGNAL","POWER","RETURN","GROUND","SHIELD","DRAIN","SPARE","UNKNOWN"]},
        "terminal_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":2,"uniqueItems":true},
        "section_mm2": {"$ref":"#/$defs/Value"}
      },
      "additionalProperties": false
    },
    "Equipment": {
      "type": "object",
      "required": ["id","item_reference","native_anchor","evidence_ids"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "item_reference": {"$ref":"#/$defs/Value"},
        "native_anchor": {"anyOf":[{"$ref":"#/$defs/NativeAnchor"},{"type":"null"}]},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true}
      },
      "additionalProperties": false
    },
    "Port": {
      "type": "object",
      "required": ["id","equipment_id","function","direction","frame_id","origin_mm","exit_axis","evidence_ids"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "equipment_id": {"$ref":"#/$defs/Id"},
        "function": {"type":"string","minLength":1},
        "direction": {"enum":["IN","OUT","BIDIRECTIONAL","PASSIVE","UNKNOWN"]},
        "frame_id": {"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
        "origin_mm": {"anyOf":[{"$ref":"#/$defs/Vector3"},{"type":"null"}]},
        "exit_axis": {"anyOf":[{"$ref":"#/$defs/Vector3"},{"type":"null"}]},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true}
      },
      "additionalProperties": false
    },
    "ConnectorReceptacle": {
      "type": "object",
      "required": ["id","port_id","part_reference","frame_id","origin_mm","orientation","locking","evidence_ids","family","keying"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "port_id": {"$ref":"#/$defs/Id"},
        "part_reference": {"$ref":"#/$defs/Value"},
        "frame_id": {"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
        "origin_mm": {"anyOf":[{"$ref":"#/$defs/Vector3"},{"type":"null"}]},
        "orientation": {"anyOf":[{"$ref":"#/$defs/Matrix4"},{"type":"null"}]},
        "locking": {"$ref":"#/$defs/Value"},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true},
        "family": {"$ref":"#/$defs/Value"},
        "keying": {"$ref":"#/$defs/Value"}
      },
      "additionalProperties": false
    },
    "ConnectorMate": {
      "type": "object",
      "required": ["id","cable_id","end_id","receptacle_id","part_reference","assembly_state","evidence_ids","family","keying"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "cable_id": {"$ref":"#/$defs/Id"},
        "end_id": {"$ref":"#/$defs/Id"},
        "receptacle_id": {"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
        "part_reference": {"$ref":"#/$defs/Value"},
        "assembly_state": {"enum":["MATED","UNMATED","UNKNOWN"]},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true},
        "family": {"$ref":"#/$defs/Value"},
        "keying": {"$ref":"#/$defs/Value"}
      },
      "additionalProperties": false
    },
    "Contact": {
      "type": "object",
      "required": ["id","owner_type","owner_id","cavity","pin_id","mating_contact_id","part_reference","evidence_ids"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "owner_type": {"enum":["RECEPTACLE","MATE"]},
        "owner_id": {"$ref":"#/$defs/Id"},
        "cavity": {"type":"string","minLength":1},
        "pin_id": {"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
        "mating_contact_id": {"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
        "part_reference": {"$ref":"#/$defs/Value"},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true}
      },
      "additionalProperties": false
    },
    "Pin": {
      "type": "object",
      "required": ["id","port_id","number","signal","role","evidence_ids"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "port_id": {"$ref":"#/$defs/Id"},
        "number": {"type":"string","minLength":1},
        "signal": {"type":"string","minLength":1},
        "role": {"enum":["SIGNAL","POWER","RETURN","GROUND","SHIELD","RESERVED","UNKNOWN"]},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true}
      },
      "additionalProperties": false
    },
    "Circuit": {
      "type": "object",
      "required": ["id","group_id","function","kind","scope","pin_ids","spans","evidence_ids"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "group_id": {"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
        "function": {"type":"string","minLength":1},
        "kind": {"enum":["SIGNAL","POWER","RETURN","GROUND","SHIELD","DRAIN"]},
        "scope": {"enum":["ONBOARD","OEM_INTERNAL","PCB_INTERNAL","DIRECT","WIRELESS","GROUND_SUPPORT","RESERVED","REMOVED"]},
        "pin_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true},
        "spans": {"type":"array","items":{"$ref":"#/$defs/Span"},"minItems":0,"uniqueItems":true},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true}
      },
      "additionalProperties": false
    },
    "Cable": {
      "type": "object",
      "required": ["id","part_reference","kind","end_ids","conductors","outer_diameter_mm","min_static_radius_mm","min_dynamic_radius_mm","linear_mass_g_m","evidence_ids"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "part_reference": {"$ref":"#/$defs/Value"},
        "kind": {"enum":["SINGLE_CORE","MULTICORE","COAX","ASSEMBLY","UNKNOWN"]},
        "end_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":2,"uniqueItems":true},
        "conductors": {"type":"array","items":{"$ref":"#/$defs/Conductor"},"minItems":0,"uniqueItems":true},
        "outer_diameter_mm": {"$ref":"#/$defs/Value"},
        "min_static_radius_mm": {"$ref":"#/$defs/Value"},
        "min_dynamic_radius_mm": {"$ref":"#/$defs/Value"},
        "linear_mass_g_m": {"$ref":"#/$defs/Value"},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true}
      },
      "additionalProperties": false
    },
    "HarnessSegment": {
      "type": "object",
      "required": ["id","start_node_id","end_node_id","cable_ids","protection_reference","mechanical_interface_ids","envelope_evidence_ids","evidence_ids"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "start_node_id": {"$ref":"#/$defs/Id"},
        "end_node_id": {"$ref":"#/$defs/Id"},
        "cable_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":1,"uniqueItems":true},
        "protection_reference": {"$ref":"#/$defs/Value"},
        "mechanical_interface_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true},
        "envelope_evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true}
      },
      "additionalProperties": false
    },
    "Route": {
      "type": "object",
      "required": ["id","representation","frame_id","state_id","cable_ids","segment_ids","geometry_kind","points_mm","native_anchor","evidence_ids"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "representation": {"enum":["CABLE_AXIS","SHARED_AXIS","RESERVATION"]},
        "frame_id": {"$ref":"#/$defs/Id"},
        "state_id": {"$ref":"#/$defs/Id"},
        "cable_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true},
        "segment_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true},
        "geometry_kind": {"enum":["POLYLINE","NATIVE","UNKNOWN"]},
        "points_mm": {"anyOf":[{"type":"array","items":{"$ref":"#/$defs/Vector3"},"minItems":2},{"type":"null"}]},
        "native_anchor": {"anyOf":[{"$ref":"#/$defs/NativeAnchor"},{"type":"null"}]},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true}
      },
      "additionalProperties": false,
      "allOf": [
        {"if":{"properties":{"representation":{"const":"CABLE_AXIS"}}},"then":{"properties":{"cable_ids":{"minItems":1,"maxItems":1}}}},
        {"if":{"properties":{"representation":{"const":"SHARED_AXIS"}}},"then":{"properties":{"cable_ids":{"minItems":2}}}},
        {"if":{"properties":{"geometry_kind":{"const":"POLYLINE"}}},"then":{"properties":{"points_mm":{"type":"array"},"native_anchor":{"type":"null"}}}},
        {"if":{"properties":{"geometry_kind":{"const":"NATIVE"}}},"then":{"properties":{"points_mm":{"type":"null"},"native_anchor":{"$ref":"#/$defs/NativeAnchor"}}}},
        {"if":{"properties":{"geometry_kind":{"const":"UNKNOWN"}}},"then":{"properties":{"points_mm":{"type":"null"},"native_anchor":{"type":"null"}}}}
      ]
    },
    "MechanicalInterface": {
      "type": "object",
      "required": ["id","kind","subject_ids","frame_id","state_ids","envelope_evidence_ids","dimensions","evidence_ids"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "kind": {"enum":["MATING","SERVICE","RETENTION","PASSAGE","MOTION"]},
        "subject_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":1,"uniqueItems":true},
        "frame_id": {"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
        "state_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true},
        "envelope_evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true},
        "dimensions": {"type":"object","additionalProperties":{"$ref":"#/$defs/Value"}},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true}
      },
      "additionalProperties": false
    },
    "Requirement": {
      "type": "object",
      "required": ["id","revision","subject_ids","classification","domain","applicability","operator","criterion","method","evidence_ids"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "revision": {"type":"string","minLength":1},
        "subject_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":1,"uniqueItems":true},
        "classification": {"enum":["MANDATORY","MODIFIABLE","INHERITED","UNKNOWN"]},
        "domain": {"enum":["CAD","BENCH","PHYSICAL","DOCUMENT"]},
        "applicability": {"enum":["APPLICABLE","NOT_APPLICABLE","UNKNOWN"]},
        "operator": {"enum":["GE","LE","EQ","TRUE","FALSE"]},
        "criterion": {"$ref":"#/$defs/Value"},
        "method": {"type":"string","minLength":1},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true}
      },
      "additionalProperties": false
    },
    "ResearchQuestion": {
      "type": "object",
      "required": ["id","subject_ids","status","question","hypothesis","expected_evidence","refutation","dependent_decision","evidence_ids"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "subject_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":1,"uniqueItems":true},
        "status": {"enum":["OPEN","CLOSED"]},
        "question": {"type":"string","minLength":1},
        "hypothesis": {"type":"string","minLength":1},
        "expected_evidence": {"type":"string","minLength":1},
        "refutation": {"type":"string","minLength":1},
        "dependent_decision": {"type":"string","minLength":1},
        "evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true}
      },
      "additionalProperties": false
    },
    "TechnicalEvidence": {
      "type": "object",
      "required": ["id","kind","domain","artifact_path","uri","sha256","locator","revision","collected_at","method","hypothetical","limits"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "kind": {"enum":["SOURCE","OBSERVATION","CALCULATION","ASSUMPTION","EXECUTION"]},
        "domain": {"enum":["CAD","BENCH","PHYSICAL","DOCUMENT"]},
        "artifact_path": {"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
        "uri": {"anyOf":[{"type":"string","format":"uri"},{"type":"null"}]},
        "sha256": {"anyOf":[{"$ref":"#/$defs/Sha256"},{"type":"null"}]},
        "locator": {"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
        "revision": {"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
        "collected_at": {"type":"string","format":"date-time","pattern":"Z$"},
        "method": {"type":"string","minLength":1},
        "hypothetical": {"type":"boolean"},
        "limits": {"type":"string","minLength":1}
      },
      "additionalProperties": false
    },
    "EngineeringDecision": {
      "type": "object",
      "required": ["id","decision","authority","decided_at","scope","report_ids","question_ids","reason","conditions","closure_method"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "decision": {"enum":["GO","CONDITIONAL_GO","NO_GO"]},
        "authority": {"type":"string","minLength":1},
        "decided_at": {"type":"string","format":"date-time","pattern":"Z$"},
        "scope": {"type":"string","minLength":1},
        "report_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":1,"uniqueItems":true},
        "question_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true},
        "reason": {"type":"string","minLength":1},
        "conditions": {"type":"array","items":{"type":"string","minLength":1},"minItems":0,"uniqueItems":true},
        "closure_method": {"anyOf":[{"type":"string","minLength":1},{"type":"null"}]}
      },
      "additionalProperties": false,
      "allOf": [
        {"if":{"properties":{"decision":{"const":"CONDITIONAL_GO"}}},"then":{"properties":{"conditions":{"minItems":1},"closure_method":{"type":"string","minLength":1}}}}
      ]
    },
    "Candidate": {
      "type": "object",
      "required": ["id","parent_candidate_id","state","baseline_sha256","requirements_sha256","changes","assumption_evidence_ids","native_evidence_id","artifact_evidence_ids"],
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "parent_candidate_id": {"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
        "state": {"enum":["DRAFT","PLANNED","BUILT"]},
        "baseline_sha256": {"anyOf":[{"$ref":"#/$defs/Sha256"},{"type":"null"}]},
        "requirements_sha256": {"anyOf":[{"$ref":"#/$defs/Sha256"},{"type":"null"}]},
        "changes": {"type":"array","items":{"type":"object","required":["subject_id","operation","reason"],"properties":{"subject_id":{"$ref":"#/$defs/Id"},"operation":{"enum":["ADD","UPDATE","REMOVE"]},"reason":{"type":"string","minLength":1}},"additionalProperties":false},"minItems":1},
        "assumption_evidence_ids": {"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"uniqueItems":true},
        "native_evidence_id": {"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
