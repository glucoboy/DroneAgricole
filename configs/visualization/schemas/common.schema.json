{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drone-agricole.local/schemas/common.v1.json",
  "title": "Types communs du tableau de bord Drone Agricole",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "minLength": 1,
      "maxLength": 96
    },
    "schemaName": {
      "type": "string",
      "pattern": "^drone_agricole\\.[a-z0-9_.-]+\\.v[1-9][0-9]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+$",
      "maxLength": 128
    },
    "jsonValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array"},
        {"type": "object"}
      ]
    },
    "inputReference": {
      "type": "object",
      "required": ["input_id", "kind", "reference"],
      "properties": {
        "input_id": {"$ref": "#/$defs/identifier"},
        "kind": {
          "enum": ["dataset_sequence", "map", "mission", "model", "calibration", "scenario", "other"]
        },
        "reference": {"type": "object"},
        "checksums": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "parameterDefinition": {
      "type": "object",
      "required": ["id", "label", "description", "type", "group", "safety_class", "default"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "type": {"enum": ["number", "integer", "boolean", "string", "enum"]},
        "unit": {"type": "string"},
        "group": {"enum": ["principal", "advanced", "structural", "safety", "derived"]},
        "safety_class": {"enum": ["analysis", "simulation", "sitl_confirmed", "read_only"]},
        "default": {"$ref": "#/$defs/jsonValue"},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "step": {"type": "number", "exclusiveMinimum": 0},
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": {
              "value": {"$ref": "#/$defs/jsonValue"},
              "label": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "restart_required": {"type": "boolean"},
        "visible_when": {"type": "object"},
        "runner_key": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
