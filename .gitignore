# ROS 2 / colcon
build/
install/
log/

# Datasets et résultats volumineux
datasets/**
!datasets/README.md
!datasets/manifests/
!datasets/manifests/**
results/**
!results/README.md

# Modèles et enregistrements
*.bag
*.db3
*.mcap
*.pcap
*.pcd
*.las
*.laz
*.onnx
*.engine
*.pt
*.pth

# CAO lourde : manifestes et documentation restent versionnables
hardware/mecanique/**/*.FCStd
hardware/mecanique/**/*.FCStd1
hardware/mecanique/**/*.FCBak
hardware/mecanique/**/sources_fabricants/**
hardware/mecanique/**/exports/**
hardware/mecanique/**/*.png

# Environnements et caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.cache/
.runtime/

# IDE / OS
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Secrets
.env
.env.*
!.env.example
*.key
*.pem
hardware/mecanique/cartographe/verification/node_modules/

# Pièces jointes de session et aperçus temporaires
.codex-remote-attachments/
outputs/**/*.png
outputs/**/*.inspect.ndjson

